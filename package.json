{
  "name": "magenta-windows",
  "version": "0.1.0",
  "private": false,
  "bin": {
    "magenta": "./bin/magenta.mjs"
  },
  "files": [
    "bin",
    "scripts/release_weights.py",
    "engine/magenta_win/*.py",
    "engine/server.py",
    "engine/model_code",
    "engine/pyproject.toml",
    "engine/uv.lock",
    "engine/.python-version",
    "install.ps1",
    "setup.ps1",
    "magenta.cmd",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "node ./bin/dev.mjs",
    "magenta": "node ./bin/magenta.mjs",
    "start": "node ./bin/magenta.mjs serve",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "clean": "turbo run clean",
    "typecheck": "turbo typecheck",
    "shadcn": "pnpm --filter @workspace/ui shadcn",
    "tauri": "pnpm --filter native tauri",
    "web": "pnpm --filter web",
    "deps:check": "taze -r",
    "deps:update": "taze -r -w -i -I"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@workspace/typescript-config": "workspace:*",
    "rimraf": "^6.1.3",
    "taze": "^21.1.0",
    "turbo": "^2.10.10",
    "typescript": "~7.0.2",
    "ultracite": "7.8.3"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=20"
  }
}
